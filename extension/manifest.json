{
  "manifest_version": 3,
  "name": "Email Tracker for Gmail",
  "version": "1.2.0",
  "description": "Live open stats for emails sent through your Email Tracker dashboard.",
  "permissions": ["storage", "activeTab", "alarms"],
  "host_permissions": [
    "https://mail.google.com/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Email Tracker for Gmail",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
